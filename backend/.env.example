# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# YOLOv8 Computer Vision API Configuration
# Option 1: Use local Ultralytics YOLOv8 model file (.pt)
YOLO_MODEL_PATH=models/yolov8n.pt

# Option 2: Connect to External YOLOv8 Inference API
EXTERNAL_YOLO_API_ENABLED=false
EXTERNAL_YOLO_API_URL=https://api.your-company.com/v1/detect
EXTERNAL_YOLO_API_KEY=

# Inspection Decision Logic Thresholds
DAMAGE_CONFIDENCE_THRESHOLD=0.35
MANUAL_REVIEW_LOW_THRESHOLD=0.25
MANUAL_REVIEW_HIGH_THRESHOLD=0.45

# Allowed Disqualifying Damage Classes
# Detections of these classes above threshold will trigger an INSPECTION FAILED state
DISQUALIFYING_CLASSES=["crack", "dent", "broken_parts", "frame_damage", "loose_cable"]
MINOR_DAMAGE_CLASSES=["scratch", "paint_peel", "scuff"]
MAX_ALLOWED_MINOR_SCRATCHES=2

# Security & Provenance
REQUIRE_MANDATORY_VIEWS=true
MANDATORY_VIEWS=["front", "rear", "left", "right"]
